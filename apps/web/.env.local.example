# ==============================================================================
# OlahData Environment Variables (.env.local.example)
# Salin berkas ini ke .env.local di apps/web/.
# JANGAN PERNAH meng-commit berkas .env.local yang berisi kunci rahasia!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (CLIENT & BROWSER PUBLIC)
# Aman diakses oleh browser klien, hak akses dibatasi oleh Row Level Security (RLS).
# Catatan: URL harus berformat https://<project-ref>.supabase.co (bukan publishable key token).
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# ------------------------------------------------------------------------------
# 2. SUPABASE (SERVER ONLY — RAHASIA TINGKAT TINGGI!)
# DILARANG KERAS di-expose ke browser / komponen klien!
# DILARANG memberi awalan NEXT_PUBLIC_!
# Hanya digunakan oleh Next.js Route Handlers dan Server Actions.
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# 3. SUPER ADMIN & KEAMANAN (SERVER ONLY)
# Daftar email admin yang berwenang mengakses /admin. Dipisahkan tanda koma.
# ------------------------------------------------------------------------------
ADMIN_EMAILS=admin@kampus.ac.id,bimbingan@kampus.ac.id
