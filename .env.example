# ==============================================================================
# OlahData Environment Variables (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (CLIENT & BROWSER PUBLIC)
# Aman untuk dipublikasikan ke browser; hak akses diatur ketat oleh Row Level Security (RLS).
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM0MTk0MjN9.MOCK_ANON_KEY_DEMO

# ------------------------------------------------------------------------------
# 2. SUPABASE (SERVER ONLY — RAHASIA TINGKAT TINGGI!)
# DILARANG KERAS di-expose ke browser / client!
# Hanya digunakan oleh Next.js Server Route Handlers dan Mesin Statistik Python.
# Memiliki kemampuan bypass RLS untuk memproses antrean worker dan webhook Midtrans.
# ------------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzQxOTQyM30.MOCK_SERVICE_ROLE_KEY_DEMO

# ------------------------------------------------------------------------------
# 3. STATISTICAL ENGINE & WORKER
# Layanan Python FastAPI terisolasi. Hanya diakses oleh Next.js server-to-server.
# ------------------------------------------------------------------------------
STATS_ENGINE_URL=http://127.0.0.1:8000
STATS_ENGINE_SECRET=olahdata_secret_engine_token_2026

# ------------------------------------------------------------------------------
# 4. LLM API (PENJELASAN AKADEMIK & NUMBER GUARD)
# ------------------------------------------------------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY (MIDTRANS)
# ------------------------------------------------------------------------------
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxx
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js

# ------------------------------------------------------------------------------
# 6. SUPER ADMIN CONSOLE (SERVER ONLY — STRICT PRIVACY & STEALTH)
# DILARANG memberi awalan NEXT_PUBLIC_! Jangan pernah masuk ke bundel klien!
# Akses hanya diberikan kepada email terverifikasi (email_verified = true)
# yang terdaftar persis di ADMIN_EMAILS. Pengguna non-admin menerima respon 404 murni.
# ------------------------------------------------------------------------------
ADMIN_EMAILS=bimdarmawa2@gmail.com,vrimae23@gmail.com
ADMIN_PATH=/admin
ADMIN_MFA_REQUIRED=true

